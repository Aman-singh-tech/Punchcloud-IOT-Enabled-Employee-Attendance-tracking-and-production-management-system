# Postgres
DATABASE_URL="postgresql://punchcloud:punchcloud@localhost:5432/punchcloud?schema=public"

# App
PORT=3000
NODE_ENV=development

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Salary column encryption (AES-256-GCM key, 32 bytes, base64-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SALARY_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# AWS / S3
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="punchcloud-dev"
# If set, points the S3 client at a local endpoint (e.g. MinIO) instead of real AWS
S3_ENDPOINT=""

# Device ingestion
DEVICE_API_KEY_PEPPER="change-me-device-pepper"
